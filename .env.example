# URL final, sem barra no fim. Ex.: https://imersao.seudominio.com.br
NEXT_PUBLIC_SITE_URL=
# Checkout oficial da imersão.
NEXT_PUBLIC_CHECKOUT_URL=https://wizmarket.com.br/checkout/ai-game-lab?offer=imersao-lore1
# Convite oficial do grupo. O código usa este mesmo link se a variável estiver vazia.
# Requer novo build após alterar na Hostinger.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://whats.ly/imersao
# Métricas próprias: variáveis privadas, NUNCA usar prefixo NEXT_PUBLIC_.
# Produção precisa de Node.js ativo, não exportação para out/.
ANALYTICS_STORAGE=mysql
ANALYTICS_SITE_ORIGIN=https://alexandreboyago.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Execute node tools/metrics-credentials.mjs no seu terminal para gerar estes valores.
ANALYTICS_SESSION_SECRET=
ANALYTICS_ADMIN_PASSWORD_HASH=
# Desenvolvimento sem MySQL: ANALYTICS_STORAGE=file e
# ANALYTICS_SITE_ORIGIN=http://localhost:3000 (somente em .env.local).
