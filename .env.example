# URL final, sem barra no fim. Ex.: https://imersao.seudominio.com.br
NEXT_PUBLIC_SITE_URL=
# Checkout oficial da imersão.
NEXT_PUBLIC_CHECKOUT_URL=https://wizmarket.com.br/checkout/ai-game-lab?offer=imersao-lore1
# Convite oficial do grupo. O código usa este mesmo link se a variável estiver vazia.
# Requer novo build após alterar na Hostinger.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://whats.ly/imersao
# Opcional: URL de incorporação de um relatório restrito à sua conta Google.
# Não coloque senhas, tokens ou chaves neste campo. Reconstrua após configurar.
ANALYTICS_REPORT_EMBED_URL=
# Marque true apenas após conferir que o compartilhamento não é público.
ANALYTICS_PRIVATE_REPORT_CONFIRMED=false
